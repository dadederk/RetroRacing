          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce pulsos cortos por posición de carril; el pulso activo indica un carril seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue de courtes pulsations par position de voie ; une pulsation active indique une voie sûre."
          }
        },
        "it": {
          "stringUnit": {
