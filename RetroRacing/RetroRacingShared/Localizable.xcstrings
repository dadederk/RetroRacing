          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ścigaj się w klasycznym oknie, a następnie przenieś ten sam wyścig na stół w 3D."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
