    "settings_controls_ios": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Llisca cap a l'esquerra o la dreta per moure.\n• Toca la meitat esquerra o dreta de la pantalla.\n• Fes servir les tecles de fletxa esquerra i dreta amb un teclat connectat.\n• Amb un comandament, el D-pad i el stick esquerre mouen per defecte; pots remapejar botons en Comandament."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Wische links oder rechts zum Bewegen.\n• Tippe auf die linke oder rechte Bildschirmhälfte.\n• Nutze die Pfeiltasten links und rechts bei angeschlossener Tastatur.\n• Mit einem Controller bewegen D-pad und linker Stick standardmäßig; Tasten kannst du in den Controller-Einstellungen neu belegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Swipe left or right to move.\n• Tap the left or right half of the screen.\n• Use the left and right arrow keys when a keyboard is connected.\n• With a controller, the D-pad and left stick move by default; you can remap buttons in Controller settings."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "• Swipe left or right to move.\n• Tap the left or right half of the screen.\n• Use the left and right arrow keys when a keyboard is connected.\n• With a controller, the D-pad and left stick move by default; you can remap buttons in Controller settings."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "• Swipe left or right to move.\n• Tap the left or right half of the screen.\n• Use the left and right arrow keys when a keyboard is connected.\n• With a controller, the D-pad and left stick move by default; you can remap buttons in Controller settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "• Swipe left or right to move.\n• Tap the left or right half of the screen.\n• Use the left and right arrow keys when a keyboard is connected.\n• With a controller, the D-pad and left stick move by default; you can remap buttons in Controller settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Desliza a la izquierda o derecha para mover.\n• Toca la mitad izquierda o derecha de la pantalla.\n• Usa las teclas de flecha con un teclado conectado.\n• Con un mando, el D-pad y el stick izquierdo mueven por defecto; puedes remapear botones en los ajustes de Mando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Glisse à gauche ou à droite pour te déplacer.\n• Touche la moitié gauche ou droite de l'écran.\n• Utilise les touches fléchées gauche et droite quand un clavier est connecté.\n• Avec une manette, le D-pad et le stick gauche déplacent par défaut ; tu peux remapper les boutons dans Réglages Manette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Scorri a sinistra o a destra per muoverti.\n• Tocca la metà sinistra o destra dello schermo.\n• Usa i tasti freccia sinistra e destra con una tastiera collegata.\n• Con un controller, D-pad e stick sinistro muovono per impostazione predefinita; puoi rimappare i pulsanti nelle impostazioni Controller."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Veeg links of rechts om te bewegen.\n• Tik op de linker of rechter helft van het scherm.\n• Gebruik de pijltjestoetsen links en rechts wanneer een toetsenbord is aangesloten.\n• Met een controller bewegen de D-pad en linker stick standaard; je kunt knoppen opnieuw toewijzen in Controller-instellingen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 左右にスワイプして移動。\n• 画面の左半分/右半分をタップ。\n• キーボード接続時は左右矢印キー。\n• コントローラーでは十字キーと左スティックがデフォルト。コントローラー設定でボタンを再割り当てできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 좌우로 스와이프하여 이동.\n• 화면 왼쪽/오른쪽 절반을 탭.\n• 키보드 연결 시 좌우 화살표 키.\n• 컨트롤러에서는 D-pad와 왼쪽 스틱이 기본. 컨트롤러 설정에서 버튼을 재할당할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Deslize para a esquerda ou direita para mover.\n• Toque na metade esquerda ou direita da tela.\n• Use as setas esquerda/direita com teclado conectado.\n• Com controle, o D-pad e o analógico esquerdo movem por padrão; você pode remapear botões em Controles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 左右滑動移動。\n• 點按螢幕左半或右半。\n• 連接鍵盤時使用左右方向鍵。\n• 使用控制器時，預設以方向鍵與左搖桿移動；可在控制器設定中重新對應按鈕。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Deslize para a esquerda ou direita para mover.\n• Toque na metade esquerda ou direita do ecrã.\n• Use as setas esquerda/direita com teclado conectado.\n• Com comando, o D-pad e o analógico esquerdo movem por padrão; pode remapear botões em Controlos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 左右滑动移动。\n• 点按屏幕左半或右半。\n• 连接键盘时使用左右方向键。\n• 使用控制器时，默认以方向键与左摇杆移动；可在控制器设置中重新对应按钮。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Glissez à gauche ou à droite pour vous déplacer.\n• Touchez la moitié gauche ou droite de l'écran.\n• Utilisez les touches fléchées gauche et droite quand un clavier est connecté.\n• Avec une manette, le D-pad et le stick gauche déplacent par défaut ; vous pouvez remapper les boutons dans Réglages Manette."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Hareket etmek için sola veya sağa kaydır.\n• Ekranın sol veya sağ yarısına dokun.\n• Klavye bağlıyken sol ve sağ ok tuşlarını kullan.\n• Kumandayla yön tuşu ve sol çubuk varsayılan olarak hareket eder; düğmeleri Kumanda ayarlarından değiştirebilirsin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Przesuń palcem w lewo lub w prawo.\n• Stuknij lewą lub prawą połowę ekranu.\n• Po podłączeniu klawiatury używaj strzałek w lewo i w prawo.\n• Na kontrolerze domyślnie działa D-pad i lewy drążek; przyciski możesz zmienić w ustawieniach kontrolera."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Desliza a la izquierda o derecha para mover.\n• Toca la mitad izquierda o derecha de la pantalla.\n• Usa las teclas de flecha con un teclado conectado.\n• Con un mando, el D-pad y el stick izquierdo mueven por defecto; puedes remapear botones en los ajustes de Mando."
          }
        }
      }
    },
    "settings_controls_macos": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Fes servir les tecles de fletxa esquerra i dreta del teclat per moure.\n• Clica a la meitat esquerra o dreta de la finestra amb el trackpad o el ratolí.\n• Prem la barra espaiadora per pausar o reprendre.\n• Amb un comandament, el D-pad i el stick esquerre mouen per defecte; pots remapejar botons en Comandament."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Nutze die Pfeiltasten links und rechts auf der Tastatur zum Bewegen.\n• Klicke mit Trackpad oder Maus auf die linke oder rechte Fensterhälfte.\n• Drücke die Leertaste zum Pausieren oder Fortsetzen.\n• Mit einem Controller bewegen D-pad und linker Stick standardmäßig; Tasten kannst du in den Controller-Einstellungen neu belegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Use the left and right arrow keys on the keyboard to move.\n• Click the left or right half of the window with the trackpad or mouse.\n• Press the space bar to pause or resume.\n• With a controller, the D-pad and left stick move by default; you can remap buttons in Controller settings."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "• Use the left and right arrow keys on the keyboard to move.\n• Click the left or right half of the window with the trackpad or mouse.\n• Press the space bar to pause or resume.\n• With a controller, the D-pad and left stick move by default; you can remap buttons in Controller settings."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "• Use the left and right arrow keys on the keyboard to move.\n• Click the left or right half of the window with the trackpad or mouse.\n• Press the space bar to pause or resume.\n• With a controller, the D-pad and left stick move by default; you can remap buttons in Controller settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "• Use the left and right arrow keys on the keyboard to move.\n• Click the left or right half of the window with the trackpad or mouse.\n• Press the space bar to pause or resume.\n• With a controller, the D-pad and left stick move by default; you can remap buttons in Controller settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Usa las teclas de flecha izquierda y derecha del teclado para mover.\n• Haz clic en la mitad izquierda o derecha de la ventana con el trackpad o el ratón.\n• Pulsa la barra espaciadora para pausar o reanudar.\n• Con un mando, el D-pad y el stick izquierdo mueven por defecto; puedes remapear botones en los ajustes de Mando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Utilise les touches fléchées gauche et droite du clavier pour te déplacer.\n• Clique sur la moitié gauche ou droite de la fenêtre avec le trackpad ou la souris.\n• Appuie sur la barre d'espace pour mettre en pause ou reprendre.\n• Avec une manette, le D-pad et le stick gauche déplacent par défaut ; tu peux remapper les boutons dans Réglages Manette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Usa i tasti freccia sinistra e destra sulla tastiera per muoverti.\n• Clicca sulla metà sinistra o destra della finestra con trackpad o mouse.\n• Premi la barra spaziatrice per mettere in pausa o riprendere.\n• Con un controller, D-pad e stick sinistro muovono per impostazione predefinita; puoi rimappare i pulsanti nelle impostazioni Controller."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Gebruik de pijltjestoetsen links en rechts op het toetsenbord om te bewegen.\n• Klik op de linker of rechter helft van het venster met trackpad of muis.\n• Druk op de spatiebalk om te pauzeren of hervatten.\n• Met een controller bewegen de D-pad en linker stick standaard; je kunt knoppen opnieuw toewijzen in Controller-instellingen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• キーボードの左右矢印キーで移動。\n• トラックパッド/マウスでウィンドウの左半/右半をクリック。\n• スペースキーで一時停止/再開。\n• コントローラーでは十字キーと左スティックがデフォルト。コントローラー設定でボタンを再割り当てできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 키보드 좌우 화살표 키로 이동.\n• 트랙패드/마우스로 창 왼쪽/오른쪽 절반 클릭.\n• 스페이스바로 일시 정지/재개.\n• 컨트롤러에서는 D-pad와 왼쪽 스틱이 기본. 컨트롤러 설정에서 버튼을 재할당할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Use as setas esquerda/direita do teclado.\n• Clique na metade esquerda ou direita da janela com trackpad ou mouse.\n• Pressione a barra de espaço para pausar ou retomar.\n• Com controle, o D-pad e o analógico esquerdo movem por padrão; você pode remapear botões em Controles."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 使用鍵盤左右方向鍵移動。\n• 以觸控板/滑鼠點按視窗左半或右半。\n• 按空白鍵暫停或繼續。\n• 使用控制器時，預設以方向鍵與左搖桿移動；可在控制器設定中重新對應按鈕。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Use as setas esquerda/direita do teclado.\n• Clique na metade esquerda ou direita da janela com trackpad ou rato.\n• Pressione a barra de espaço para pausar ou retomar.\n• Com comando, o D-pad e o analógico esquerdo movem por padrão; pode remapear botões em Controlos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 使用键盘左右方向键移动。\n• 以触控板/鼠标点按视窗左半或右半。\n• 按空白键暂停或继续。\n• 使用控制器时，默认以方向键与左摇杆移动；可在控制器设置中重新对应按钮。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Utilisez les touches fléchées gauche et droite du clavier pour vous déplacer.\n• Cliquez sur la moitié gauche ou droite de la fenêtre avec le trackpad ou la souris.\n• Appuyez sur la barre d'espace pour mettre en pause ou reprendre.\n• Avec une manette, le D-pad et le stick gauche déplacent par défaut ; vous pouvez remapper les boutons dans Réglages Manette."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Hareket etmek için klavyedeki sol ve sağ ok tuşlarını kullan.\n• İzleme dörtgeni veya fareyle pencerenin sol ya da sağ yarısına tıkla.\n• Duraklatmak veya sürdürmek için boşluk tuşuna bas.\n• Kumandayla yön tuşu ve sol çubuk varsayılan olarak hareket eder; düğmeleri Kumanda ayarlarından değiştirebilirsin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Używaj strzałek w lewo i w prawo na klawiaturze.\n• Kliknij lewą lub prawą połowę okna gładzikiem albo myszą.\n• Naciśnij spację, aby wstrzymać lub wznowić grę.\n• Na kontrolerze domyślnie działa D-pad i lewy drążek; przyciski możesz zmienić w ustawieniach kontrolera."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Usa las teclas de flecha izquierda y derecha del teclado para mover.\n• Haz clic en la mitad izquierda o derecha de la ventana con el trackpad o el ratón.\n• Pulsa la barra espaciadora para pausar o reanudar.\n• Con un mando, el D-pad y el stick izquierdo mueven por defecto; puedes remapear botones en los ajustes de Mando."
          }
        }
      }
    },
    "settings_controls_tvos": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Llisca a l'esquerra o a la dreta, o fes clic a la vora esquerra o dreta del Siri Remote, per moure.\n• Prem Reproducció/Pausa per pausar o reprendre.\n• Prem Menú/Arrere per decidir si vols finalitzar la partida.\n• Amb un comandament, usa el D-pad o el stick esquerre per moure, Menú/Inici per pausar i B/Arrere per finalitzar. Els botons assignats afigen controls alternatius."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Wische auf der Siri Remote nach links oder rechts oder klicke auf den linken oder rechten Rand, um dich zu bewegen.\n• Drücke Play/Pause, um zu pausieren oder fortzufahren.\n• Drücke Menü/Zurück, um zu entscheiden, ob du das Spiel beenden möchtest.\n• Mit einem Controller bewegst du dich mit Steuerkreuz oder linkem Stick, pausierst mit Menü/Start und beendest mit B/Zurück. Zugewiesene Tasten dienen als alternative Steuerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Swipe left or right, or click the left or right edge of the Siri Remote, to move.\n• Press Play/Pause to pause or resume.\n• Press Menu/Back to choose whether to finish the game.\n• With a controller, use the D-pad or left stick to move, Menu/Start to pause, and B/Back to finish. Mapped buttons add alternate controls."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "• Swipe left or right, or click the left or right edge of the Siri Remote, to move.\n• Press Play/Pause to pause or resume.\n• Press Menu/Back to choose whether to finish the game.\n• With a controller, use the D-pad or left stick to move, Menu/Start to pause, and B/Back to finish. Mapped buttons add alternate controls."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "• Swipe left or right, or click the left or right edge of the Siri Remote, to move.\n• Press Play/Pause to pause or resume.\n• Press Menu/Back to choose whether to finish the game.\n• With a controller, use the D-pad or left stick to move, Menu/Start to pause, and B/Back to finish. Mapped buttons add alternate controls."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "• Swipe left or right, or click the left or right edge of the Siri Remote, to move.\n• Press Play/Pause to pause or resume.\n• Press Menu/Back to choose whether to finish the game.\n• With a controller, use the D-pad or left stick to move, Menu/Start to pause, and B/Back to finish. Mapped buttons add alternate controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Desliza a la izquierda o a la derecha, o pulsa el borde izquierdo o derecho del Siri Remote, para moverte.\n• Pulsa Reproducción/Pausa para pausar o reanudar.\n• Pulsa Menú/Atrás para decidir si quieres finalizar la partida.\n• Con un mando, usa el D-pad o el stick izquierdo para moverte, Menú/Inicio para pausar y B/Atrás para finalizar. Los botones asignados añaden controles alternativos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Glisse à gauche ou à droite, ou clique sur le bord gauche ou droit de la Siri Remote, pour te déplacer.\n• Appuie sur Lecture/Pause pour mettre en pause ou reprendre.\n• Appuie sur Menu/Retour pour choisir si tu veux terminer la partie.\n• Avec une manette, utilise le D-pad ou le stick gauche pour te déplacer, Menu/Start pour mettre en pause et B/Retour pour terminer. Les boutons assignés ajoutent des commandes alternatives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Scorri a sinistra o a destra, oppure premi il bordo sinistro o destro del telecomando Siri, per muoverti.\n• Premi Riproduci/Pausa per mettere in pausa o riprendere.\n• Premi Menu/Indietro per scegliere se terminare la partita.\n• Con un controller, usa il D-pad o lo stick sinistro per muoverti, Menu/Start per mettere in pausa e B/Indietro per terminare. I pulsanti assegnati aggiungono controlli alternativi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Veeg naar links of rechts, of klik op de linker- of rechterrand van de Siri Remote, om te bewegen.\n• Druk op Speel af/Pauze om te pauzeren of door te gaan.\n• Druk op Menu/Terug om te kiezen of je het spel wilt beëindigen.\n• Gebruik met een controller de D-pad of linkerstick om te bewegen, Menu/Start om te pauzeren en B/Terug om te stoppen. Toegewezen knoppen voegen alternatieve bediening toe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Siri Remoteを左右にスワイプするか、左端または右端をクリックして移動します。\n• 再生／一時停止ボタンで一時停止または再開します。\n• メニュー／戻るボタンでゲームを終了するか選びます。\n• コントローラーでは、方向パッドまたは左スティックで移動し、メニュー／スタートで一時停止、B／戻るで終了します。割り当てたボタンは代替操作として使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Siri Remote을 좌우로 쓸어 넘기거나 왼쪽 또는 오른쪽 가장자리를 클릭하여 이동해요.\n• 재생/일시 정지 버튼으로 일시 정지하거나 다시 시작해요.\n• 메뉴/뒤로 버튼으로 게임을 끝낼지 선택해요.\n• 컨트롤러에서는 방향 패드 또는 왼쪽 스틱으로 이동하고, 메뉴/시작으로 일시 정지하며, B/뒤로로 종료해요. 지정한 버튼은 보조 조작으로 사용할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Deslize para a esquerda ou direita, ou clique na borda esquerda ou direita do Siri Remote, para mover.\n• Pressione Reproduzir/Pausar para pausar ou retomar.\n• Pressione Menu/Voltar para escolher se quer encerrar a partida.\n• Com controle, use o direcional ou o analógico esquerdo para mover, Menu/Iniciar para pausar e B/Voltar para encerrar. Os botões atribuídos adicionam controles alternativos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 在 Siri Remote 上向左或向右滑動，或按一下左側或右側邊緣來移動。\n• 按下播放／暫停以暫停或繼續。\n• 按下選單／返回來選擇是否結束遊戲。\n• 使用控制器時，以方向鍵或左搖桿移動、選單／開始暫停，並以 B／返回結束。自訂按鈕可作為替代控制。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Deslize para a esquerda ou direita, ou clique na extremidade esquerda ou direita do Siri Remote, para mover.\n• Prima Reproduzir/Pausa para pausar ou retomar.\n• Prima Menu/Voltar para escolher se pretende terminar a partida.\n• Com comando, use o D-pad ou o analógico esquerdo para mover, Menu/Iniciar para pausar e B/Voltar para terminar. Os botões atribuídos adicionam controlos alternativos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 在 Siri Remote 上向左或向右滑动，或点按左侧或右侧边缘来移动。\n• 按下播放／暂停以暂停或继续。\n• 按下菜单／返回来选择是否结束游戏。\n• 使用控制器时，以方向键或左摇杆移动、菜单／开始暂停，并以 B／返回结束。自定义按钮可作为替代控制。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Glissez à gauche ou à droite, ou cliquez sur le bord gauche ou droit de la Siri Remote, pour vous déplacer.\n• Appuyez sur Lecture/Pause pour mettre en pause ou reprendre.\n• Appuyez sur Menu/Retour pour choisir si vous voulez terminer la partie.\n• Avec une manette, utilisez le D-pad ou le stick gauche pour vous déplacer, Menu/Start pour mettre en pause et B/Retour pour terminer. Les boutons assignés ajoutent des commandes alternatives."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Hareket etmek için Siri Remote'da sola veya sağa kaydır ya da sol veya sağ kenara tıkla.\n• Duraklatmak veya sürdürmek için Oynat/Duraklat'a bas.\n• Oyunu bitirip bitirmemeyi seçmek için Menü/Geri'ye bas.\n• Kumandayla yön tuşu veya sol çubukla hareket et, Menü/Başlat ile duraklat ve B/Geri ile bitir. Atanan düğmeler alternatif kontroller ekler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Przesuń palcem w lewo lub w prawo albo kliknij lewą lub prawą krawędź Siri Remote, aby się poruszyć.\n• Naciśnij Odtwarzaj/Pauza, aby wstrzymać lub wznowić grę.\n• Naciśnij Menu/Wstecz, aby zdecydować, czy zakończyć grę.\n• Na kontrolerze użyj D-pada lub lewego drążka do ruchu, Menu/Start do pauzy, a B/Wstecz do zakończenia. Przypisane przyciski dodają alternatywne sterowanie."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Desliza a la izquierda o a la derecha, o pulsa el borde izquierdo o derecho del Siri Remote, para moverte.\n• Pulsa Reproducción/Pausa para pausar o reanudar.\n• Pulsa Menú/Atrás para decidir si quieres terminar la partida.\n• Con un control, usa el D-pad o la palanca izquierda para moverte, Menú/Inicio para pausar y B/Atrás para terminar. Los botones asignados agregan controles alternativos."
          }
        }
      }
    },
    "settings_controls_visionos": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Mira un carril i fes un pessic per moure't, o usa els botons Esquerra i Dreta.\n• Usa les tecles de fletxa esquerra i dreta si hi ha un teclat connectat.\n• Prem Espai o usa Pausa per pausar o reprendre.\n• Amb un comandament, usa el D-pad o el stick esquerre per moure't i Menú/Inici per pausar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Sieh dir eine Spur an und führe eine Zwickgeste aus, oder nutze Links und Rechts.\n• Nutze bei angeschlossener Tastatur die Pfeiltasten links und rechts.\n• Drücke die Leertaste oder nutze Pause zum Pausieren und Fortsetzen.\n• Nutze mit einem Controller das D-pad oder den linken Stick zum Bewegen und Menü/Start zum Pausieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Look at a lane and pinch to move, or use the Left and Right buttons.\n• Use the left and right arrow keys when a keyboard is connected.\n• Press Space or use Pause to pause or resume.\n• With a controller, use the D-pad or left stick to move and Menu/Start to pause."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "• Look at a lane and pinch to move, or use the Left and Right buttons.\n• Use the left and right arrow keys when a keyboard is connected.\n• Press Space or use Pause to pause or resume.\n• With a controller, use the D-pad or left stick to move and Menu/Start to pause."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "• Look at a lane and pinch to move, or use the Left and Right buttons.\n• Use the left and right arrow keys when a keyboard is connected.\n• Press Space or use Pause to pause or resume.\n• With a controller, use the D-pad or left stick to move and Menu/Start to pause."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "• Look at a lane and pinch to move, or use the Left and Right buttons.\n• Use the left and right arrow keys when a keyboard is connected.\n• Press Space or use Pause to pause or resume.\n• With a controller, use the D-pad or left stick to move and Menu/Start to pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Mira un carril y pellizca para moverte, o usa los botones Izquierda y Derecha.\n• Usa las teclas de flecha izquierda y derecha con un teclado conectado.\n• Pulsa Espacio o usa Pausa para pausar o reanudar.\n• Con un mando, usa el D-pad o el stick izquierdo para moverte y Menú/Inicio para pausar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Regarde une voie et pince pour te déplacer, ou utilise les boutons Gauche et Droite.\n• Utilise les touches fléchées gauche et droite avec un clavier connecté.\n• Appuie sur Espace ou utilise Pause pour mettre en pause ou reprendre.\n• Avec une manette, utilise le D-pad ou le stick gauche pour te déplacer et Menu/Start pour mettre en pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Guarda una corsia e pizzica per muoverti, oppure usa i pulsanti Sinistra e Destra.\n• Usa i tasti freccia sinistra e destra con una tastiera collegata.\n• Premi Spazio o usa Pausa per mettere in pausa o riprendere.\n• Con un controller, usa D-pad o stick sinistro per muoverti e Menu/Start per mettere in pausa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Kijk naar een rijstrook en knijp om te bewegen, of gebruik de knoppen Links en Rechts.\n• Gebruik de pijltjestoetsen links en rechts als een toetsenbord is aangesloten.\n• Druk op de spatiebalk of gebruik Pauze om te pauzeren of hervatten.\n• Gebruik met een controller de D-pad of linkerstick om te bewegen en Menu/Start om te pauzeren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• レーンを見てピンチして移動するか、左／右ボタンを使います。\n• キーボード接続時は左右の矢印キーを使います。\n• スペースキーまたは一時停止ボタンで一時停止／再開します。\n• コントローラーでは、方向パッドまたは左スティックで移動し、メニュー／スタートで一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 차선을 바라보고 핀치하여 이동하거나 왼쪽 및 오른쪽 버튼을 사용해요.\n• 키보드 연결 시 왼쪽 및 오른쪽 화살표 키를 사용해요.\n• 스페이스바 또는 일시 정지 버튼으로 일시 정지하거나 다시 시작해요.\n• 컨트롤러에서는 방향 패드 또는 왼쪽 스틱으로 이동하고 메뉴/시작으로 일시 정지해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Olhe para uma faixa e faça o gesto de pinça para mover, ou use os botões Esquerda e Direita.\n• Use as setas esquerda e direita com um teclado conectado.\n• Pressione Espaço ou use Pausar para pausar ou retomar.\n• Com um controle, use o direcional ou o analógico esquerdo para mover e Menu/Iniciar para pausar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 看向車道並捏合以移動，或使用向左與向右按鈕。\n• 連接鍵盤時，使用左右方向鍵。\n• 按空白鍵或使用暫停來暫停或繼續。\n• 使用控制器時，以方向鍵或左搖桿移動，並以選單／開始暫停。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Olhe para uma faixa e faça o gesto de pinça para mover, ou use os botões Esquerda e Direita.\n• Use as setas esquerda e direita com um teclado ligado.\n• Prima Espaço ou use Pausa para pausar ou retomar.\n• Com um comando, use o D-pad ou o analógico esquerdo para mover e Menu/Iniciar para pausar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 看向车道并捏合以移动，或使用向左与向右按钮。\n• 连接键盘时，使用左右方向键。\n• 按空格键或使用暂停来暂停或继续。\n• 使用控制器时，以方向键或左摇杆移动，并以菜单／开始暂停。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Regardez une voie et pincez pour vous déplacer, ou utilisez les boutons Gauche et Droite.\n• Utilisez les touches fléchées gauche et droite avec un clavier connecté.\n• Appuyez sur Espace ou utilisez Pause pour mettre en pause ou reprendre.\n• Avec une manette, utilisez le D-pad ou le stick gauche pour vous déplacer et Menu/Start pour mettre en pause."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Bir şeride bakıp parmaklarını kıstırarak hareket et veya Sol ve Sağ düğmelerini kullan.\n• Klavye bağlıyken sol ve sağ ok tuşlarını kullan.\n• Duraklatmak veya sürdürmek için Boşluk tuşuna bas ya da Duraklat'ı kullan.\n• Kumandayla yön tuşu veya sol çubukla hareket et ve Menü/Başlat ile duraklat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Spójrz na pas i wykonaj gest uszczypnięcia, aby się poruszyć, albo użyj przycisków W lewo i W prawo.\n• Po podłączeniu klawiatury używaj strzałek w lewo i w prawo.\n• Naciśnij spację lub użyj Pauzy, aby wstrzymać albo wznowić grę.\n• Na kontrolerze użyj D-pada lub lewego drążka do ruchu, a Menu/Start do pauzy."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Mira un carril y pellizca para moverte, o usa los botones Izquierda y Derecha.\n• Usa las teclas de flecha izquierda y derecha con un teclado conectado.\n• Presiona Espacio o usa Pausa para pausar o reanudar.\n• Con un control, usa el D-pad o la palanca izquierda para moverte y Menú/Inicio para pausar."
          }
        }
      }
    },
    "settings_controls_watchos": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Gira la Digital Crown cap amunt per moure't a la dreta i cap avall per moure't a l'esquerra.\n• Toca la part esquerra de la pantalla per moure't a l'esquerra i la dreta per moure't a la dreta.\n• Llisca cap a l'esquerra per moure't a l'esquerra i cap a la dreta per moure't a la dreta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Drehe die Digital Crown nach oben für rechts und nach unten für links.\n• Tippe links auf den Bildschirm für links und rechts für rechts.\n• Wische links zum Bewegen nach links und rechts zum Bewegen nach rechts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Rotate the Digital Crown up to move right and down to move left.\n• Tap the left side of the screen to move left and the right side to move right.\n• Swipe left to move left and right to move right."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "• Rotate the Digital Crown up to move right and down to move left.\n• Tap the left side of the screen to move left and the right side to move right.\n• Swipe left to move left and right to move right."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "• Rotate the Digital Crown up to move right and down to move left.\n• Tap the left side of the screen to move left and the right side to move right.\n• Swipe left to move left and right to move right."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "• Rotate the Digital Crown up to move right and down to move left.\n• Tap the left side of the screen to move left and the right side to move right.\n• Swipe left to move left and right to move right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Gira la Digital Crown hacia arriba para moverte a la derecha y hacia abajo para moverte a la izquierda.\n• Toca la parte izquierda de la pantalla para moverte a la izquierda y la derecha para moverte a la derecha.\n• Desliza a la izquierda para moverte a la izquierda y a la derecha para moverte a la derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Tourne la Digital Crown vers le haut pour aller à droite et vers le bas pour aller à gauche.\n• Touche le côté gauche de l'écran pour aller à gauche et le côté droit pour aller à droite.\n• Glisse à gauche pour aller à gauche et à droite pour aller à droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Ruota la Digital Crown verso l'alto per andare a destra e verso il basso per andare a sinistra.\n• Tocca il lato sinistro dello schermo per andare a sinistra e il destro per andare a destra.\n• Scorri a sinistra per andare a sinistra e a destra per andare a destra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Draai de Digital Crown omhoog om naar rechts te gaan en omlaag om naar links te gaan.\n• Tik op de linkerkant van het scherm om naar links te gaan en op de rechterkant om naar rechts te gaan.\n• Veeg naar links om naar links te gaan en naar rechts om naar rechts te gaan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Digital Crownを上に回して右、下に回して左。\n• 画面左側をタップで左、右側をタップで右。\n• 左スワイプで左、右スワイプで右。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Digital Crown을 위로 돌리면 오른쪽, 아래로 돌리면 왼쪽.\n• 화면 왼쪽 탭은 왼쪽, 오른쪽 탭은 오른쪽.\n• 왼쪽 스와이프는 왼쪽, 오른쪽 스와이프는 오른쪽."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Gire a Digital Crown para cima para ir à direita e para baixo para ir à esquerda.\n• Toque no lado esquerdo da tela para ir à esquerda e no direito para ir à direita.\n• Deslize para a esquerda/direita para mover."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 向上轉 Digital Crown 向右，向下轉向左。\n• 點按螢幕左側向左、右側向右。\n• 左滑向左、右滑向右。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Gire a Digital Crown para cima para ir à direita e para baixo para ir à esquerda.\n• Toque no lado esquerdo do ecrã para ir à esquerda e no direito para ir à direita.\n• Deslize para a esquerda/direita para mover."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• 向上转 Digital Crown 向右，向下转向左。\n• 点按屏幕左侧向左、右侧向右。\n• 左滑向左、右滑向右。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Tourne la Digital Crown vers le haut pour aller à droite et vers le bas pour aller à gauche.\n• Touchez le côté gauche de l'écran pour aller à gauche et le côté droit pour aller à droite.\n• Glissez à gauche pour aller à gauche et à droite pour aller à droite."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Sağa gitmek için Digital Crown'u yukarı, sola gitmek için aşağı çevir.\n• Sola gitmek için ekranın soluna, sağa gitmek için sağına dokun.\n• Sola gitmek için sola, sağa gitmek için sağa kaydır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Obróć Digital Crown w górę, aby jechać w prawo, i w dół, aby jechać w lewo.\n• Stuknij lewą stronę ekranu, aby jechać w lewo, lub prawą, aby jechać w prawo.\n• Przesuń w lewo albo w prawo, aby zmienić pas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "• Gira la Digital Crown hacia arriba para moverte a la derecha y hacia abajo para moverte a la izquierda.\n• Toca la parte izquierda de la pantalla para moverte a la izquierda y la derecha para moverte a la derecha.\n• Desliza a la izquierda para moverte a la izquierda y a la derecha para moverte a la derecha."
          }
        }
      }
    },
