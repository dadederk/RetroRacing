          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa del tema Pocket. Vibras de consola de bolsillo: dos coches verde musgo, dos cascos robustos, un choque crujiente y una paleta de carretera apagada de una pantalla clásica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu du thème Pocket. Ambiance mini-console: deux voitures vert mousse, deux casques trapus, un crash croustillant et une palette de route feutrée venue d'un vieil écran de poche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima del tema Pocket. Atmosfera da mini console: due auto verde muschio, due caschi robusti, uno schianto croccante e una palette stradale attenuata da vecchio schermo tascabile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Themapreview voor Pocket. Mini-handheldsfeer: twee mosgroene raceauto's, twee stevige helmen, een knetterende crash en een gedempt wegpalet van een oud zakscherm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocketテーマのプレビュー。小さな携帯ゲーム機のムード。苔色のレーサー2台、ずんぐりしたヘルメット2つ、ザクッとしたクラッシュ、昔のポケット画面みたいな渋い道路パレット。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket 테마 미리보기. 작은 휴대용 게임기 감성: 이끼빛 레이서 두 대, 큼직한 헬멧 두 개, 바삭한 충돌 효과, 오래된 포켓 화면 같은 차분한 도로 팔레트."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia do tema Pocket. Clima de portátil de bolso: dois carros verde-musgo, dois capacetes parrudos, uma batida crocante e uma paleta de pista suave de tela antiga."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket 主題預覽。掌上遊戲機氛圍：兩台苔綠色賽車、兩頂厚實頭盔、清脆的撞擊效果，以及像老式口袋螢幕的柔和道路配色。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualização do tema Pocket. Ambiente de portátil de bolso: dois carros verde-musgo, dois capacetes robustos, um embate crocante e uma paleta de estrada suave de um ecrã antigo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket 主题预览。掌上游戏机氛围：两辆苔绿色赛车、两顶厚实头盔、清脆的撞击效果，以及像老式口袋屏幕的柔和道路配色。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu du thème Pocket. Ambiance mini-console: deux voitures vert mousse, deux casques trapus, un crash croustillant et une palette de route feutrée venue d'un vieil écran de poche."
          }
        }
      }
    },
    "settings_theme_gallery_preview_accessibility_sixteen_bit": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualització del tema 16-Bit. Drama arcade dels noranta: dos cotxes de píxels més rics, dos cascos brillants, una explosió de foc i una carretera grisa ràpida entre gespa verda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau für das 16-Bit-Theme. Frühe Arcade-Dramatik: zwei detailreichere Pixelautos, zwei glänzende Helme, ein feuriger Crash und eine schnelle graue Straße durch grünes Gras."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "16-Bit theme preview. Early arcade drama: two richer pixel cars, two glossy helmets, a fiery crash, and a fast gray road cutting through green grass."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "16-Bit theme preview. Early arcade drama: two richer pixel cars, two glossy helmets, a fiery crash, and a fast grey road cutting through green grass."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "16-Bit theme preview. Early arcade drama: two richer pixel cars, two glossy helmets, a fiery crash, and a fast gray road cutting through green grass."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "16-Bit theme preview. Early arcade drama: two richer pixel cars, two glossy helmets, a fiery crash, and a fast grey road cutting through green grass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa del tema 16-Bit. Drama arcade noventero: dos coches pixelados más ricos, dos cascos brillantes, una explosión ardiente y una carretera gris rápida entre hierba verde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu du thème 16-Bit. Drame arcade rétro: deux voitures pixel plus riches, deux casques brillants, un crash flamboyant et une route grise rapide entre l'herbe verte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima del tema 16-Bit. Dramma arcade d'altri tempi: due auto pixel più ricche, due caschi lucidi, uno schianto infuocato e una strada grigia veloce nell'erba verde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Themapreview voor 16-Bit. Vroege arcadedrama: twee rijkere pixelauto's, twee glanzende helmen, een vurige crash en een snelle grijze weg door groen gras."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "16-Bitテーマのプレビュー。初期アーケードのドラマ。濃いピクセルカー2台、つやのあるヘルメット2つ、燃えるクラッシュ、緑の芝生を切り裂く速いグレーの道路。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "16-Bit 테마 미리보기. 초기 아케이드 드라마: 더 풍부한 픽셀 자동차 두 대, 반짝이는 헬멧 두 개, 불타는 충돌, 초록 잔디를 가르는 빠른 회색 도로."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia do tema 16-Bit. Drama arcade clássico: dois carros pixelados mais ricos, dois capacetes brilhantes, uma batida flamejante e uma pista cinza veloz cortando a grama verde."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "16-Bit 主題預覽。早期街機戲劇感：兩台更細緻的像素車、兩頂亮面頭盔、火焰般的撞擊，以及穿過綠草的高速灰色道路。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualização do tema 16-Bit. Drama arcade clássico: dois carros pixelizados mais ricos, dois capacetes brilhantes, um embate flamejante e uma estrada cinzenta veloz a cortar a relva verde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "16-Bit 主题预览。早期街机戏剧感：两辆更细致的像素车、两顶亮面头盔、火焰般的撞击，以及穿过绿草的高速灰色道路。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu du thème 16-Bit. Drame arcade rétro: deux voitures pixel plus riches, deux casques brillants, un crash flamboyant et une route grise rapide entre l'herbe verte."
          }
        }
      }
    },
