    "vision_play_description": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Corre en una finestra clàssica i després porta la mateixa cursa a la taula en 3D."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fahre in einem klassischen Fenster und verschiebe dasselbe Rennen danach in 3D auf deinen Tisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Race in a classic window, then move the same run onto your table in 3D."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Race in a classic window, then move the same run onto your table in 3D."
