    "tutorial_audio_move_style_description_haptics": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduïx vibració d'èxit si el carril és segur i vibració de moviment si no ho és."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt ein Erfolgs-Haptik-Feedback bei sicherer Spur und ein Bewegungs-Haptik-Feedback bei unsicherer Spur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a success haptic for a safe lane and a move haptic for an unsafe lane."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a success haptic for a safe lane and a move haptic for an unsafe lane."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a success haptic for a safe lane and a move haptic for an unsafe lane."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a success haptic for a safe lane and a move haptic for an unsafe lane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce háptica de éxito si el carril es seguro y háptica de movimiento si no lo es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue un retour haptique de succès pour une voie sûre et un retour de mouvement pour une voie dangereuse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce feedback aptico di successo se la corsia è sicura e di movimento se non lo è."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt haptische feedback bij succes voor een veilige baan en beweging voor een onveilige baan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全レーンでは成功触覚、危険レーンでは移動触覚を再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전 차선에서는 성공 햅틱, 위험 차선에서는 이동 햅틱을 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca um háptico de sucesso para faixa segura e de movimento para faixa insegura."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全車道播放成功觸覺，危險車道播放移動觸覺。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca um háptico de sucesso para faixa segura e de movimento para faixa insegura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全车道播放成功触觉，危险车道播放移动触觉。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue un retour haptique de succès pour une voie sûre et un retour de mouvement pour une voie dangereuse."
          }
        }
      }
    },
    "tutorial_audio_move_style_description_lane_and_safety": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduïx la confirmació de carril i tot seguit el to d'èxit o error."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt Spurbestätigung gefolgt von Erfolgs- oder Fehlerton."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays lane confirmation followed by a success or fail tone."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays lane confirmation followed by a success or fail tone."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays lane confirmation followed by a success or fail tone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays lane confirmation followed by a success or fail tone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce la confirmación de carril y después un tono de éxito o error."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue la confirmation de voie suivie d'un ton de succès ou d'échec."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce la conferma di corsia seguita da un tono di successo o errore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt baansbevestiging gevolgd door een succes- of fouttoon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーン確認の後に成功/失敗トーンを再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차선 확인 후 성공/실패 톤을 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca confirmação de faixa seguida de tom de sucesso ou falha."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先播放車道確認，再播放成功或失敗音。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca confirmação de faixa seguida de tom de sucesso ou falha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先播放车道确认，再播放成功或失败音。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue la confirmation de voie suivie d'un ton de succès ou d'échec."
          }
        }
      }
    },
    "tutorial_audio_move_style_description_lane_confirmation": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduïx només la nota del carril de destinació quan et mous a l'esquerra o a la dreta, perquè puguis fer-la coincidir amb la pista d'àudio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt nur die Zielspur-Note beim Bewegen nach links oder rechts, damit du sie mit dem Audio-Hinweis abgleichen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays only the destination lane note, as you move left or right, so you can match it with the audio cue."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays only the destination lane note, as you move left or right, so you can match it with the audio cue."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays only the destination lane note, as you move left or right, so you can match it with the audio cue."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays only the destination lane note, as you move left or right, so you can match it with the audio cue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce solo la nota del carril de destino al moverte a izquierda o derecha, para que puedas hacerla coincidir con la pista de audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue uniquement la note de la voie de destination quand tu te déplaces à gauche ou à droite, pour la faire correspondre à l'indice audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce solo la nota della corsia di destinazione quando ti muovi a sinistra o a destra, così puoi abbinarla al segnale audio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt alleen de bestemmingsbaan-noot wanneer je naar links of rechts beweegt, zodat je die kunt matchen met de audio-aanwijzing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右移動時に目的地レーンの音だけを再生し、音声キューと合わせられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좌우 이동 시 목적지 차선 음만 재생해 오디오 큐와 맞출 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca apenas a nota da faixa de destino ao mover esquerda/direita, para combinar com a pista sonora."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左右移動時只播放目標車道音，方便對照音效提示。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca apenas a nota da faixa de destino ao mover esquerda/direita, para combinar com a pista sonora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右移动时只播放目标车道音，方便对照音效提示。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue uniquement la note de la voie de destination quand tu te déplaces à gauche ou à droite, pour la faire correspondre à l'indice audio."
          }
        }
      }
    },
