        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Courez dans une fenêtre classique, puis placez la même course sur votre table en 3D."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
