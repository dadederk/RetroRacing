          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@テーマのプレビュー。2台の車、2つのヘルメット、爆発、道路の色を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 테마 미리보기. 두 자동차, 두 헬멧, 폭발, 도로 색상을 보여 줍니다."
