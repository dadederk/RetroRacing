    "settings_theme_gallery_preview_accessibility_eight_bit": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualització del tema 8-Bit. Espurna de consola de saló: dos cotxes de píxels valents, dos cascos amb força, una explosió taronja calenta i una carretera grisa arcade amb línies grogues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau für das 8-Bit-Theme. Heimkonsolen-Funkeln: zwei kräftige Pixelautos, zwei markante Helme, ein heißer orangener Crash und eine graue Arcade-Straße mit leuchtend gelben Linien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8-Bit theme preview. Home-console sparkle: two bold pixel cars, two punchy helmets, a hot orange crash, and a gray arcade road with bright yellow lines."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "8-Bit theme preview. Home-console sparkle: two bold pixel cars, two punchy helmets, a hot orange crash, and a grey arcade road with bright yellow lines."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "8-Bit theme preview. Home-console sparkle: two bold pixel cars, two punchy helmets, a hot orange crash, and a gray arcade road with bright yellow lines."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "8-Bit theme preview. Home-console sparkle: two bold pixel cars, two punchy helmets, a hot orange crash, and a grey arcade road with bright yellow lines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa del tema 8-Bit. Brillo de consola de salón: dos coches pixelados atrevidos, dos cascos con carácter, una explosión naranja intensa y una carretera arcade gris con líneas amarillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu du thème 8-Bit. Éclat de console de salon: deux voitures pixel audacieuses, deux casques punchy, un crash orange brûlant et une route arcade grise aux lignes jaune vif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima del tema 8-Bit. Scintilla da console di casa: due auto pixel decise, due caschi grintosi, uno schianto arancione acceso e una strada arcade grigia con linee gialle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Themapreview voor 8-Bit. Huiskamerconsole-energie: twee stoere pixelauto's, twee pittige helmen, een hete oranje crash en een grijze arcadeweg met felgele lijnen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8-Bitテーマのプレビュー。家庭用コンソールのきらめき。太いピクセルカー2台、パンチのあるヘルメット2つ、熱いオレンジのクラッシュ、鮮やかな黄色ラインのグレーのアーケード道路。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8-Bit 테마 미리보기. 가정용 콘솔의 반짝임: 굵직한 픽셀 자동차 두 대, 강렬한 헬멧 두 개, 뜨거운 주황색 충돌, 선명한 노란 선이 있는 회색 아케이드 도로."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia do tema 8-Bit. Brilho de console de casa: dois carros pixelados marcantes, dois capacetes cheios de atitude, uma batida laranja quente e uma pista arcade cinza com linhas amarelas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "8-Bit 主題預覽。家用主機的閃亮感：兩台大膽像素車、兩頂有力頭盔、熱烈橘色撞擊，以及有亮黃線條的灰色街機道路。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualização do tema 8-Bit. Brilho de consola caseira: dois carros pixelizados marcantes, dois capacetes cheios de atitude, um embate laranja quente e uma estrada arcade cinzenta com linhas amarelas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "8-Bit 主题预览。家用主机的闪亮感：两辆大胆像素车、两顶有力头盔、热烈橙色撞击，以及带亮黄线条的灰色街机道路。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu du thème 8-Bit. Éclat de console de salon: deux voitures pixel audacieuses, deux casques punchy, un crash orange brûlant et une route arcade grise aux lignes jaune vif."
          }
        }
      }
    },
    "settings_theme_gallery_preview_accessibility_lcd": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualització del tema LCD. Ambient de calculadora arcade: dos cotxes nítids, dos cascos nets, una explosió lluminosa i una carretera clara per a rècords al sol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau für das LCD-Theme. Taschenrechner-Arcade-Stimmung: zwei klare Rennwagen, zwei saubere Helme, ein heller Crash und eine helle Straße für sonnige Highscore-Runden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LCD theme preview. Calculator-arcade vibes: two crisp racers, two clean helmets, a bright crash, and a pale road palette built for sunny high-score runs."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "LCD theme preview. Calculator-arcade vibes: two crisp racers, two clean helmets, a bright crash, and a pale road palette built for sunny high-score runs."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "LCD theme preview. Calculator-arcade vibes: two crisp racers, two clean helmets, a bright crash, and a pale road palette built for sunny high-score runs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "LCD theme preview. Calculator-arcade vibes: two crisp racers, two clean helmets, a bright crash, and a pale road palette built for sunny high-score runs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa del tema LCD. Ambiente de calculadora arcade: dos coches nítidos, dos cascos limpios, una explosión brillante y una carretera clara para récords bajo el sol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu du thème LCD. Ambiance calculatrice arcade: deux voitures nettes, deux casques propres, un crash lumineux et une route pâle pour les records au soleil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima del tema LCD. Atmosfera da calcolatrice arcade: due auto nitide, due caschi puliti, uno schianto luminoso e una strada chiara per record sotto il sole."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Themapreview voor LCD. Rekenmachine-arcadesfeer: twee strakke raceauto's, twee nette helmen, een felle crash en een lichte weg voor zonnige highscore-rondes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LCDテーマのプレビュー。電卓アーケードのムード。くっきりしたレーサー2台、すっきりしたヘルメット2つ、明るいクラッシュ、太陽の下でハイスコアを狙う淡い道路パレット。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LCD 테마 미리보기. 계산기 아케이드 감성: 또렷한 레이서 두 대, 깔끔한 헬멧 두 개, 밝은 충돌 효과, 햇살 속 최고 점수에 어울리는 연한 도로 팔레트."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia do tema LCD. Clima de calculadora arcade: dois carros nítidos, dois capacetes limpos, uma batida brilhante e uma pista clara para recordes ao sol."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LCD 主題預覽。計算機街機氛圍：兩台俐落賽車、兩頂乾淨頭盔、明亮撞擊效果，以及適合陽光高分賽道的淡色道路配色。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualização do tema LCD. Ambiente de calculadora arcade: dois carros nítidos, dois capacetes limpos, um embate luminoso e uma estrada clara para recordes ao sol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LCD 主题预览。计算器街机氛围：两辆利落赛车、两顶干净头盔、明亮撞击效果，以及适合阳光高分赛道的淡色道路配色。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu du thème LCD. Ambiance calculatrice arcade: deux voitures nettes, deux casques propres, un crash lumineux et une route pâle pour les records au soleil."
          }
        }
      }
    },
    "settings_theme_gallery_preview_accessibility_pocket": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualització del tema Pocket. Ambient de consola de butxaca: dos cotxes verd molsa, dos cascos robustos, un esclat cruixent i una paleta de carretera apagada d'una pantalla clàssica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau für das Pocket-Theme. Kleine Handheld-Vibes: zwei moosgrüne Rennwagen, zwei kantige Helme, ein knackiger Crash und eine gedämpfte Straßenpalette wie auf einem alten Taschendisplay."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket theme preview. Tiny handheld vibes: two moss-green racers, two chunky helmets, a crunchy crash, and a muted road palette from an old pocket screen."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket theme preview. Tiny handheld vibes: two moss-green racers, two chunky helmets, a crunchy crash, and a muted road palette from an old pocket screen."
