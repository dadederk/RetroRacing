            "value": "Joue toutes les voies sûres en même temps comme un accord."
          }
        }
      }
    },
    "tutorial_audio_mode_description_lane_pulses": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduïx polsos curts per posició de carril; el pols actiu indica un carril segur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt kurze Pulse in Spurpositionen; ein aktiver Puls markiert eine sichere Spur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays short pulses in lane slots; an active pulse marks a safe lane."
