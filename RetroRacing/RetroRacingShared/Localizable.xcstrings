    "settings_controller_footnote": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els botons remapejats substituïxen les assignacions predeterminades de D-pad/Menú per a eixes accions. El stick esquerre continua com a suport esquerra/dreta. Les tecles de fletxa continuen actives al Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neu zugewiesene Tasten ersetzen die Standard-D-pad/Menü-Belegungen für diese Aktionen. Der linke Stick bleibt als Links/Rechts-Backup. Pfeiltasten bleiben auf dem Mac aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remapped buttons replace the default D-pad/Menu bindings for those actions. The left stick remains a left/right backup. Arrow keys remain active on Mac."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Remapped buttons replace the default D-pad/Menu bindings for those actions. The left stick remains a left/right backup. Arrow keys remain active on Mac."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Remapped buttons replace the default D-pad/Menu bindings for those actions. The left stick remains a left/right backup. Arrow keys remain active on Mac."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Remapped buttons replace the default D-pad/Menu bindings for those actions. The left stick remains a left/right backup. Arrow keys remain active on Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los botones remapeados sustituyen las asignaciones predeterminadas de D-pad/Menú para esas acciones. El stick izquierdo sigue como respaldo izquierda/derecha. Las teclas de flecha siguen activas en Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les boutons remappés remplacent les assignations D-pad/Menu par défaut pour ces actions. Le stick gauche reste une option gauche/droite. Les touches fléchées restent actives sur Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I pulsanti rimappati sostituiscono le assegnazioni predefinite di D-pad/Menu per quelle azioni. Lo stick sinistro resta come backup sinistra/destra. I tasti freccia restano attivi su Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hertoegewezen knoppen vervangen de standaard D-pad/Menu-toewijzingen voor die acties. De linker stick blijft als links/rechts-back-up. Pijltjestoetsen blijven actief op Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "再割り当てしたボタンは、その操作のデフォルトの十字キー/メニューを置き換えます。左スティックは左右のバックアップとして残ります。Macでは矢印キーも有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "재할당한 버튼은 해당 동작의 기본 D-pad/메뉴를 대체합니다. 왼쪽 스틱은 좌우 백업으로 남습니다. Mac에서는 화살표 키도 활성화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Botões remapeados substituem os padrões de D-pad/Menu para essas ações. O analógico esquerdo continua como backup esquerda/direita. As setas permanecem ativas no Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新對應的按鈕會取代該動作的預設方向鍵/選單。左搖桿仍可作为左右備援。Mac 上方向鍵仍可使用。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Botões remapeados substituem os padrões de D-pad/Menu para essas ações. O analógico esquerdo continua como backup esquerda/direita. As setas permanecem ativas no Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新对应的按钮会取代该动作的默认方向键/选单。左摇杆仍可作为左右备援。Mac 上方向键仍可使用。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les boutons remappés remplacent les assignations D-pad/Menu par défaut pour ces actions. Le stick gauche reste une option gauche/droite. Les touches fléchées restent actives sur Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeniden atanan düğmeler, bu eylemler için varsayılan yön tuşu/Menü eşlemelerinin yerini alır. Sol çubuk, sol/sağ yedeği olarak kalır. Ok tuşları Mac'te etkin kalır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przypisane przyciski zastępują domyślne ustawienia D-pada/Menu dla tych działań. Lewy drążek nadal działa jako zapasowe sterowanie lewo/prawo. Klawisze strzałek pozostają aktywne na Macu."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los botones remapeados sustituyen las asignaciones predeterminadas de D-pad/Menú para esas acciones. El stick izquierdo sigue como respaldo izquierda/derecha. Las teclas de flecha siguen activas en Mac."
          }
        }
      }
    },
    "settings_controller_footnote_tvos": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Els controls estàndard D-pad/stick esquerre i Menú/Inici sempre funcionen. Els botons A, X, Y, superiors i gallets assignats afigen controls alternatius. B/Arrere obri la confirmació per finalitzar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Standardsteuerung mit Steuerkreuz/linkem Stick und Menü/Start funktioniert immer. Zugewiesene A-, X-, Y-, Schulter- und Trigger-Tasten dienen als Alternativen. B/Zurück öffnet die Bestätigung zum Beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard D-pad/left stick and Menu/Start controls always work. Mapped A, X, Y, shoulder, and trigger buttons add alternate controls. B/Back opens the finish confirmation."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard D-pad/left stick and Menu/Start controls always work. Mapped A, X, Y, shoulder, and trigger buttons add alternate controls. B/Back opens the finish confirmation."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard D-pad/left stick and Menu/Start controls always work. Mapped A, X, Y, shoulder, and trigger buttons add alternate controls. B/Back opens the finish confirmation."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard D-pad/left stick and Menu/Start controls always work. Mapped A, X, Y, shoulder, and trigger buttons add alternate controls. B/Back opens the finish confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los controles estándar D-pad/stick izquierdo y Menú/Inicio siempre funcionan. Los botones A, X, Y, superiores y gatillos asignados añaden controles alternativos. B/Atrás abre la confirmación para finalizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les commandes standard D-pad/stick gauche et Menu/Start fonctionnent toujours. Les boutons A, X, Y, les boutons supérieurs et les gâchettes assignés ajoutent des alternatives. B/Retour ouvre la confirmation pour terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I controlli standard D-pad/stick sinistro e Menu/Start funzionano sempre. I pulsanti A, X, Y, dorsali e grilletti assegnati aggiungono controlli alternativi. B/Indietro apre la conferma per terminare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De standaardbediening met D-pad/linkerstick en Menu/Start werkt altijd. Toegewezen A-, X-, Y-, schouder- en triggerknoppen voegen alternatieve bediening toe. B/Terug opent de bevestiging om te stoppen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "標準の方向パッド／左スティックとメニュー／スタートは常に使えます。割り当てたA、X、Y、ショルダー、トリガーボタンは代替操作になります。B／戻るで終了確認を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기본 방향 패드/왼쪽 스틱과 메뉴/시작 조작은 항상 사용할 수 있어요. 지정한 A, X, Y, 숄더, 트리거 버튼은 보조 조작으로 사용돼요. B/뒤로는 종료 확인을 열어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os controles padrão com direcional/analógico esquerdo e Menu/Iniciar sempre funcionam. Os botões A, X, Y, superiores e gatilhos atribuídos adicionam controles alternativos. B/Voltar abre a confirmação para encerrar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "標準方向鍵／左搖桿與選單／開始控制永遠有效。自訂的 A、X、Y、肩鍵和扳機鍵可作為替代控制。B／返回會開啟結束確認。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os controlos padrão com D-pad/analógico esquerdo e Menu/Iniciar funcionam sempre. Os botões A, X, Y, superiores e gatilhos atribuídos adicionam controlos alternativos. B/Voltar abre a confirmação para terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "标准方向键／左摇杆与菜单／开始控制始终有效。自定义的 A、X、Y、肩键和扳机键可作为替代控制。B／返回会打开结束确认。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les commandes standard D-pad/stick gauche et Menu/Start fonctionnent toujours. Les boutons A, X, Y, les boutons supérieurs et les gâchettes assignés ajoutent des alternatives. B/Retour ouvre la confirmation pour terminer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Standart yön tuşu/sol çubuk ve Menü/Başlat kontrolleri her zaman çalışır. Atanan A, X, Y, omuz ve tetik düğmeleri alternatif kontroller ekler. B/Geri, bitirme onayını açar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Standardowe sterowanie D-padem/lewym drążkiem oraz Menu/Start zawsze działa. Przypisane przyciski A, X, Y, przyciski boczne i spusty dodają alternatywne sterowanie. B/Wstecz otwiera potwierdzenie zakończenia."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los controles estándar D-pad/palanca izquierda y Menú/Inicio siempre funcionan. Los botones A, X, Y, superiores y gatillos asignados agregan controles alternativos. B/Atrás abre la confirmación para terminar."
          }
        }
      }
    },
