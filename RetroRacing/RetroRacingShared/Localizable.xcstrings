        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia do tema %@. Mostra os dois carros, os dois capacetes, a explosão e as cores da pista."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 主題預覽。顯示兩台車、兩頂頭盔、爆炸和道路顏色。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualização do tema %@. Mostra os dois carros, os dois capacetes, a explosão e as cores da estrada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 主题预览。显示两辆车、两顶头盔、爆炸和道路颜色。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
