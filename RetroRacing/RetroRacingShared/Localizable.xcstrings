    "settings_restore_footer": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si ja has comprat partides il·limitades en un altre dispositiu, toca Restaurar compres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du Unbegrenzte Spiele auf einem anderen Gerät gekauft hast, tippe auf Käufe wiederherstellen."
          }
