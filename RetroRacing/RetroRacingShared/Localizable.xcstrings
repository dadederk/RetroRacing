        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全なレーンをすべて同時にコードとして再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 차선을 모두 동시에 코드로 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca todas as faixas seguras ao mesmo tempo como um acorde."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時以和弦播放所有安全車道。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca todas as faixas seguras ao mesmo tempo como um acorde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时以和弦播放所有安全车道。"
          }
