    "settings_theme_gallery_unlock_body": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vols canviar de tema, aconseguir Partides il·limitades i també donar suport al desenvolupament del joc?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willst du Themes wechseln, Unbegrenzte Spiele bekommen und die Entwicklung des Spiels unterstützen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want to change themes, get Unlimited Plays, and support the game's development too?"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Want to change themes, get Unlimited Plays, and support the game's development too?"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Want to change themes, get Unlimited Plays, and support the game's development too?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Want to change themes, get Unlimited Plays, and support the game's development too?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres cambiar de tema, conseguir Partidas ilimitadas y apoyar también el desarrollo del juego?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu veux changer de thème, profiter de Parties illimitées et soutenir aussi le développement du jeu ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi cambiare tema, ottenere Partite illimitate e sostenere anche lo sviluppo del gioco?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil je thema's wijzigen, Onbeperkt spelen krijgen en ook de ontwikkeling van de game steunen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマを変更して、無制限プレイを手に入れて、ゲーム開発も応援しませんか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마도 바꾸고, 무제한 플레이도 얻고, 게임 개발도 응원하고 싶나요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quer mudar de tema, liberar Partidas Ilimitadas e também apoiar o desenvolvimento do jogo?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想更換主題、取得無限暢玩，並支持遊戲開發嗎？"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quer mudar de tema, desbloquear Partidas Ilimitadas e também apoiar o desenvolvimento do jogo?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想更换主题、取得无限畅玩，并支持游戏开发吗？"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu veux changer de thème, profiter de Parties illimitées et soutenir aussi le développement du jeu ?"
          }
        }
      }
    },
