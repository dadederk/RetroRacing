    "settings_theme_gallery_preview_accessibility %@": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualització del tema %@. Mostra els dos cotxes, els dos cascos, l'explosió i els colors de la carretera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme-Vorschau für %@. Zeigt beide Autos, beide Helme, die Explosion und die Straßenfarben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme preview for %@. Shows both cars, both helmets, the explosion, and the road colors."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme preview for %@. Shows both cars, both helmets, the explosion, and the road colours."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme preview for %@. Shows both cars, both helmets, the explosion, and the road colors."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme preview for %@. Shows both cars, both helmets, the explosion, and the road colours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa del tema %@. Muestra los dos coches, los dos cascos, la explosión y los colores de la carretera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu du thème %@. Affiche les deux voitures, les deux casques, l’explosion et les couleurs de la route."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima del tema %@. Mostra entrambe le auto, entrambi i caschi, l'esplosione e i colori della strada."
