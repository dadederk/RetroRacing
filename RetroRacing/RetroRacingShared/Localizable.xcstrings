          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーンスロットで短いパルスを再生。アクティブなパルスが安全レーンを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차선 슬롯에서 짧은 펄스를 재생합니다. 활성 펄스가 안전 차선을 표시합니다."
          }
        },
        "pt-BR": {
