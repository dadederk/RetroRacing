    "settings_theme_gallery_preview_accessibility %@": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Previsualització del tema %@. Mostra els dos cotxes, els dos cascos, l'explosió i els colors de la carretera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Theme-Vorschau für %@. Zeigt beide Autos, beide Helme, die Explosion und die Straßenfarben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme preview for %@. Shows both cars, both helmets, the explosion, and the road colors."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme preview for %@. Shows both cars, both helmets, the explosion, and the road colours."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme preview for %@. Shows both cars, both helmets, the explosion, and the road colors."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme preview for %@. Shows both cars, both helmets, the explosion, and the road colours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vista previa del tema %@. Muestra los dos coches, los dos cascos, la explosión y los colores de la carretera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aperçu du thème %@. Affiche les deux voitures, les deux casques, l’explosion et les couleurs de la route."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anteprima del tema %@. Mostra entrambe le auto, entrambi i caschi, l'esplosione e i colori della strada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Themapreview voor %@. Toont beide auto's, beide helmen, de explosie en de wegkleuren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@テーマのプレビュー。2台の車、2つのヘルメット、爆発、道路の色を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 테마 미리보기. 두 자동차, 두 헬멧, 폭발, 도로 색상을 보여 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prévia do tema %@. Mostra os dois carros, os dois capacetes, a explosão e as cores da pista."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 主題預覽。顯示兩台車、兩頂頭盔、爆炸和道路顏色。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pré-visualização do tema %@. Mostra os dois carros, os dois capacetes, a explosão e as cores da estrada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 主题预览。显示两辆车、两顶头盔、爆炸和道路颜色。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aperçu du thème %@. Affiche les deux voitures, les deux casques, l’explosion et les couleurs de la route."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ teması önizlemesi. İki arabayı, iki kaskı, patlamayı ve yol renklerini gösterir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podgląd motywu %@. Pokazuje oba samochody, oba kaski, wybuch i kolory drogi."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vista previa del tema %@. Muestra los dos carros, los dos cascos, la explosión y los colores de la carretera."
          }
        }
      }
    },
    "settings_theme_gallery_preview_accessibility_eight_bit": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Previsualització del tema %@. Espurna de consola de saló: dos cotxes de píxels valents, dos cascos amb força, una explosió taronja calenta i una carretera grisa arcade amb línies grogues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vorschau für das %@-Theme. Heimkonsolen-Funkeln: zwei kräftige Pixelautos, zwei markante Helme, ein heißer orangener Crash und eine graue Arcade-Straße mit leuchtend gelben Linien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ theme preview. Home-console sparkle: two bold pixel cars, two punchy helmets, a hot orange crash, and a gray arcade road with bright yellow lines."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ theme preview. Home-console sparkle: two bold pixel cars, two punchy helmets, a hot orange crash, and a grey arcade road with bright yellow lines."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ theme preview. Home-console sparkle: two bold pixel cars, two punchy helmets, a hot orange crash, and a gray arcade road with bright yellow lines."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ theme preview. Home-console sparkle: two bold pixel cars, two punchy helmets, a hot orange crash, and a grey arcade road with bright yellow lines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vista previa del tema %@. Brillo de consola de salón: dos coches pixelados atrevidos, dos cascos con carácter, una explosión naranja intensa y una carretera arcade gris con líneas amarillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aperçu du thème %@. Éclat de console de salon: deux voitures pixel audacieuses, deux casques punchy, un crash orange brûlant et une route arcade grise aux lignes jaune vif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anteprima del tema %@. Scintilla da console di casa: due auto pixel decise, due caschi grintosi, uno schianto arancione acceso e una strada arcade grigia con linee gialle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Themapreview voor %@. Huiskamerconsole-energie: twee stoere pixelauto's, twee pittige helmen, een hete oranje crash en een grijze arcadeweg met felgele lijnen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@テーマのプレビュー。家庭用コンソールのきらめき。太いピクセルカー2台、パンチのあるヘルメット2つ、熱いオレンジのクラッシュ、鮮やかな黄色ラインのグレーのアーケード道路。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 테마 미리보기. 가정용 콘솔의 반짝임: 굵직한 픽셀 자동차 두 대, 강렬한 헬멧 두 개, 뜨거운 주황색 충돌, 선명한 노란 선이 있는 회색 아케이드 도로."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prévia do tema %@. Brilho de console de casa: dois carros pixelados marcantes, dois capacetes cheios de atitude, uma batida laranja quente e uma pista arcade cinza com linhas amarelas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 主題預覽。家用主機的閃亮感：兩台大膽像素車、兩頂有力頭盔、熱烈橘色撞擊，以及有亮黃線條的灰色街機道路。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pré-visualização do tema %@. Brilho de consola caseira: dois carros pixelizados marcantes, dois capacetes cheios de atitude, um embate laranja quente e uma estrada arcade cinzenta com linhas amarelas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 主题预览。家用主机的闪亮感：两辆大胆像素车、两顶有力头盔、热烈橙色撞击，以及带亮黄线条的灰色街机道路。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aperçu du thème %@. Éclat de console de salon: deux voitures pixel audacieuses, deux casques punchy, un crash orange brûlant et une route arcade grise aux lignes jaune vif."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ tema önizlemesi. Ev konsolu ışıltısı: iki cesur piksel araba, iki çarpıcı kask, sıcak turuncu çarpışma ve parlak sarı çizgili gri arcade yolu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podgląd motywu %@. Blask domowej konsoli: dwa wyraziste pikselowe auta, dwa mocne kaski, gorąca pomarańczowa kraksa i szara droga arcade z jasnożółtymi liniami."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vista previa del tema %@. Brillo de consola de salón: dos carros pixelados atrevidos, dos cascos con carácter, una explosión naranja intensa y una carretera arcade gris con líneas amarillas."
          }
        }
      }
    },
    "settings_theme_gallery_preview_accessibility_lcd": {
      "extractionState": "manual",
