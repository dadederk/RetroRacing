    "tutorial_audio_mode_description_arpeggio": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduïx els carrils segurs una nota darrere d'una altra, d'esquerra a dreta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt sichere Spuren nacheinander von links nach rechts ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays safe lanes one note after another from left to right."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays safe lanes one note after another from left to right."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays safe lanes one note after another from left to right."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays safe lanes one note after another from left to right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce los carriles seguros una nota tras otra, de izquierda a derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue les voies sûres une note après l'autre, de gauche à droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce le corsie sicure una nota dopo l'altra, da sinistra a destra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt veilige banen één voor één af, van links naar rechts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全なレーンを左から右へ順番に1音ずつ再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 차선을 왼쪽에서 오른쪽으로 하나씩 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca as faixas seguras uma nota após a outra, da esquerda para a direita."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依序播放安全車道的音符，由左至右。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca as faixas seguras uma nota após a outra, da esquerda para a direita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依序播放安全车道的音符，由左至右。"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue les voies sûres une note après l'autre, de gauche à droite."
          }
        }
      }
    },
    "tutorial_audio_mode_description_chord": {
      "extractionState": "manual",
      "localizations": {
